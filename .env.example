# Product identity（Package.appxmanifest / Partner Center と一致）
MS_STORE_PACKAGE_NAME=StudioTomippe.19837858EB356
MS_STORE_PUBLISHER_ID=CN=7AA9757D-D72F-4DE2-9980-F9A659207C27
